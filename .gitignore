# 依赖与构建产物
node_modules/
.pnpm-store/

# 本地凭据（绝对不要提交）
authorization.dpapi
authorization.json
access-token.dpapi
access.token
*.dpapi
.credentials*
.env
.env.*

# 传输记录（⚠️ 0.4.0 起会落盘，里面带本机绝对路径 + Windows 用户名）
# 形如 {"transfers":[{"localPath":"C:\\Users\\<名字>\\Downloads\\..."}]}
# 它和凭据放在同一个目录，但文件名不在上面的白名单里 —— 曾经漏过。
transfers.json
transfers.json.tmp-*
*.transfers.json

# 日志与临时文件
*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db

# 编辑器
.vscode/
.idea/
*.swp

# 本机调试脚本（开发时可能临时生成）
_*.mjs
_*.ps1

# 本机发布脚本（含个人路径提示）
publish.ps1

# npm pack 产物
*.tgz
